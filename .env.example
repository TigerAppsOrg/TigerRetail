# Copy to .env.local. Never commit real values.
APP_URL=http://localhost:3000
# openssl rand -base64 48
SESSION_SECRET=

# ---- database and photos (bun run setup fills these in) ----
# TigerRetail development PostgreSQL database (ask the project lead)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
# Private S3 bucket for listing photos and avatars; CloudFront serves reads.
AWS_REGION=us-east-1
S3_BUCKET=tigerretail-photos-104733724423-us-east-1
S3_PUBLIC_URL=https://d1ugkt2f7zwiiq.cloudfront.net
# Local development only: AWS CLI profile with access to the photo bucket.
# Run aws sso login --profile <profile>. Omit on EC2; its IAM role supplies credentials.
# AWS_PROFILE=TigerApps

# ---- listserv import ----
# netids allowed to run imports and approve them, comma-separated
ADMIN_NETIDS=
# Claude (Sonnet) reads the slide decks
ANTHROPIC_API_KEY=
# InboxEngine finds the sale emails (ask TigerApps for a token)
INBOX_ENGINE_URL=https://inbox-engine.tigerapps.org
INBOX_ENGINE_TOKEN=
# protects /api/cron/import (the daily scheduled job sends it; bun run import uses it). openssl rand -hex 24
CRON_SECRET=

# Invites to people whose listserv sales were imported (admin clicks "send invite").
# SendGrid first: TigerApps' account is authenticated for princeton.edu, so mail
# can come from tigerretail@princeton.edu (ask TigerApps for a sending-only key).
SENDGRID_API_KEY=
# Or Resend (resend.com): until a domain is verified it sends from
# onboarding@resend.dev and only reaches the Resend account's own email.
RESEND_API_KEY=
# Test mode (the default): every invite goes here instead of the seller.
INVITE_TEST_RECIPIENT=rp4348@princeton.edu
# Only "on" sends invites to the real sellers. Leave unset while testing.
INVITES_TO_SELLERS=
MAIL_FROM="TigerRetail <tigerretail@princeton.edu>"
