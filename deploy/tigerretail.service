[Unit]
Description=TigerRetail Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tigerretail
Group=tigerretail
WorkingDirectory=/opt/tigerretail/current
EnvironmentFile=/opt/tigerretail/shared/environment
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /opt/tigerretail/current/server.js
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tigerretail
UMask=0027

[Install]
WantedBy=multi-user.target
